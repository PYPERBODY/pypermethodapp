# Supabase public client configuration for The PYPER Method Interactive Guide.
# Do not put service-role keys in Vite/frontend environment variables.

# Preferred Vite variable names:
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-publishable-key

# Also supported for compatibility with Supabase/Next setup snippets:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
